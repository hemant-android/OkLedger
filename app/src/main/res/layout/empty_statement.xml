<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emptyRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/dimen_32dp">

    <!-- Empty Illustration Icon -->
    <ImageView
        android:id="@+id/imgEmpty"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="@string/text_no_parties_yet_add_a_party"
        android:src="@drawable/ic_empty_ledger"
        app:tint="@color/colorPrimary" />

    <!-- Message -->
    <TextView
        android:id="@+id/tvEmpty"
        style="@style/S16Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:gravity="center"
        android:text="@string/text_no_statement_yet" />

    <!-- Add Party Button -->
    <Button
        android:id="@+id/btnAddParty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:background="@drawable/bg_button_primary"
        android:elevation="4dp"
        android:paddingHorizontal="@dimen/dimen_32dp"
        android:paddingVertical="@dimen/dimen_10dp"
        android:text="@string/text_add_party"
        android:textAllCaps="false"
        android:textColor="@color/white" />

</LinearLayout>
