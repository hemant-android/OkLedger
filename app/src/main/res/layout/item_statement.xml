<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dimen_10dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llGivenSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:background="@drawable/bg_rtl"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dimen_10dp"
        android:paddingVertical="@dimen/dimen_5dp"
        android:visibility="gone"
        tools:ignore="RtlHardcoded">

        <TextView
            android:id="@+id/tvAmountGiven"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 500"
            android:textSize="@dimen/text_18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNoteGiven"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sample note"
            android:textColor="#999"
            android:textSize="@dimen/dimen_12dp" />

        <TextView
            android:id="@+id/tvDateGiven"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="12 Oct 2025"
            android:textColor="#999"
            android:textSize="@dimen/text_12sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llReceivedSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ltr"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dimen_10dp"
        android:paddingVertical="@dimen/dimen_5dp"
        android:visibility="gone"
        tools:ignore="RtlHardcoded">

        <TextView
            android:id="@+id/tvAmountReceived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 500"
            android:textSize="@dimen/text_18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNoteReceived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sample note"
            android:textColor="#999"
            android:textSize="@dimen/dimen_12dp" />

        <TextView
            android:id="@+id/tvDateReceived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="12 Oct 2025"
            android:textColor="#999"
            android:textSize="@dimen/text_12sp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <TextView
        android:id="@+id/tvType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Given"
        android:textStyle="bold"
        android:visibility="gone" />

</androidx.appcompat.widget.LinearLayoutCompat>
