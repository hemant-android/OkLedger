<resources>
    <!-- Base application theme -->
    <style name="Theme.OkLedger" parent="Theme.MaterialComponents.Light.NoActionBar">

        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/colorPrimary</item> <!-- #1976D2 -->
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item> <!-- #0D47A1 -->
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/colorAccent</item> <!-- #FFC107 -->
        <item name="colorSecondaryVariant">@color/secondaryColor</item> <!-- #2196F3 -->
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/backgroundLight</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/gray</item>

        <!-- Buttons -->
        <item name="colorButtonNormal">@color/colorPrimary</item>
        <item name="android:textColorHighlight">@color/colorAccent</item>

        <!-- Ripple & highlight -->
        <item name="android:colorControlHighlight">@color/secondaryColorLight</item>

        <!-- Typography -->
        <item name="fontFamily">@font/poppins_regular</item>

        <!-- Toolbar styling -->
        <item name="android:actionBarStyle">@style/Widget.App.Toolbar</item>
        <item name="android:toolbarStyle">@style/Widget.App.Toolbar</item>
    </style>

    <!-- Toolbar style -->
    <style name="Widget.App.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/colorPrimary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
    </style>

    <!-- Font style -->
    <style name="BaseTextRegular">
        <item name="android:includeFontPadding">false</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="fontFamily">@font/poppins_regular</item>
    </style>

    <style name="BaseTextMedium">
        <item name="android:includeFontPadding">false</item>
